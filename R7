        bool _ce_accept_event = _ce_touch_event and (_direction == 1 ? close < _ce : close > _ce)
        bool _rejection_event = _current_ce_touch and (_direction == 1 ? close > _ce : close < _ce)

        float _penetration = _direction == 1 ? math.max(_top - low, 0.0) / _height : math.max(high - _bottom, 0.0) / _height
