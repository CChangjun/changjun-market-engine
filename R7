f_add_structure_label(structure_labels, bear_structure_break_event, bar_index, high, bear_mss_event ? "MSS ↓" : bear_choch_event ? "CHOCH ↓" : "BOS ↓", false, max_structure_labels, show_structure_events)

//=====================================================
// Re-arm / Leg Counters
//=====================================================
var bool long_armed = true
var bool short_armed = true
var int last_long_signal_bar = na
var int last_short_signal_bar = na
var int bull_leg_long_count = 0
var int bear_leg_short_count = 0

bull_leg_event = bull_major_sweep or bos_bull
bear_leg_event = bear_major_sweep or bos_bear

if bull_leg_event
    bull_leg_long_count := 0

if bear_leg_event
    bear_leg_short_count := 0

long_reset_condition = (
    (rearm_use_opposite_sweep and (recent_bear_major_sweep or recent_bear_minor_sweep)) or
    (rearm_use_ema_reset and close < ema_fast) or
    (rearm_use_disp_reset and bear_disp)
)

short_reset_condition = (
    (rearm_use_opposite_sweep and (recent_bull_major_sweep or recent_bull_minor_sweep)) or
    (rearm_use_ema_reset and close > ema_fast) or
    (rearm_use_disp_reset and bull_disp)
)

if long_reset_condition
    long_armed := true

if short_reset_condition
    short_armed := true

long_cooldown_ok = na(last_long_signal_bar) or bar_index - last_long_signal_bar > signal_cooldown_bars
short_cooldown_ok = na(last_short_signal_bar) or bar_index - last_short_signal_bar > signal_cooldown_bars

//=====================================================
// Acceptance / Rejection
//=====================================================
bull_rejection_score = 0.0
bull_acceptance_penalty = 0.0
if bull_proximity and not na(near_bull_ref_all)
    bull_rejection_score += low <= near_bull_ref_all and close > near_bull_ref_all ? 1.0 : 0.0
    bull_rejection_score += bull_reclaim_body >= atr_val * sweep_reclaim_body_atr ? 0.5 : 0.0
    bull_rejection_score += volume > vol_ma * vol_mult ? 0.25 : 0.0
    bull_acceptance_penalty += close < near_bull_ref_all and bear_disp ? 0.75 : 0.0
    bull_acceptance_penalty += close < near_bull_ref_all and volume > vol_ma * vol_mult ? 0.25 : 0.0

bear_rejection_score = 0.0
bear_acceptance_penalty = 0.0
if bear_proximity and not na(near_bear_ref_all)
    bear_rejection_score += high >= near_bear_ref_all and close < near_bear_ref_all ? 1.0 : 0.0
    bear_rejection_score += bear_reclaim_body >= atr_val * sweep_reclaim_body_atr ? 0.5 : 0.0
    bear_rejection_score += volume > vol_ma * vol_mult ? 0.25 : 0.0
    bear_acceptance_penalty += close > near_bear_ref_all and bull_disp ? 0.75 : 0.0
    bear_acceptance_penalty += close > near_bear_ref_all and volume > vol_ma * vol_mult ? 0.25 : 0.0

//=====================================================
// Hazard-style Zone Failure
//=====================================================
bull_fill_risk = nz(near_bull_fill_all, 0.0)
bear_fill_risk = nz(near_bear_fill_all, 0.0)
bull_touch_risk = f_clamp(nz(near_bull_touches_all, 0.0) / hazard_touch_norm, 0.0, 1.0)
bear_touch_risk = f_clamp(nz(near_bear_touches_all, 0.0) / hazard_touch_norm, 0.0, 1.0)

bull_zone_hazard = f_clamp(
    hazard_survival_weight * (1.0 - bull_zone_quality) +
    hazard_fill_weight * bull_fill_risk +
    hazard_touch_weight * bull_touch_risk +
    hazard_accept_weight * f_clamp(bull_acceptance_penalty, 0.0, 1.0),
    0.0, 1.0
)

bear_zone_hazard = f_clamp(
    hazard_survival_weight * (1.0 - bear_zone_quality) +
    hazard_fill_weight * bear_fill_risk +
    hazard_touch_weight * bear_touch_risk +
    hazard_accept_weight * f_clamp(bear_acceptance_penalty, 0.0, 1.0),
    0.0, 1.0
)

bull_zone_stability = 1.0 - bull_zone_hazard
bear_zone_stability = 1.0 - bear_zone_hazard

//=====================================================
// Approach / Reaction Quality
//=====================================================
bull_grind_penalty = bull_proximity and close < close[1] and close[1] < close[2] and volume < vol_ma
bear_grind_penalty = bear_proximity and close > close[1] and close[1] > close[2] and volume < vol_ma

bull_sweep_score = bull_major_sweep ? 2.0 + bull_liq_density : bull_minor_sweep ? 0.85 + bull_liq_density * 0.35 : bull_minor_sweep_raw ? 0.20 : 0.0
bear_sweep_score = bear_major_sweep ? 2.0 + bear_liq_density : bear_minor_sweep ? 0.85 + bear_liq_density * 0.35 : bear_minor_sweep_raw ? 0.20 : 0.0

bull_approach_score = 0.0
bull_approach_score += recent_bull_major_sweep ? 2.0 : recent_bull_minor_sweep ? 0.85 : 0.0
bull_approach_score += bull_proximity ? 0.5 : 0.0
bull_approach_score += native_eff >= eff_min ? 0.50 : -0.25
bull_approach_score += bull_zone_quality > 0.70 ? 1.0 : bull_zone_quality > 0.50 ? 0.5 : bull_zone_quality < min_survival_score ? -1.0 : 0.0
bull_approach_score -= bull_grind_penalty ? 1.0 : 0.0
bull_approach_score += trend_clarity >= 0.45 ? 0.35 : -0.50

bear_approach_score = 0.0
bear_approach_score += recent_bear_major_sweep ? 2.0 : recent_bear_minor_sweep ? 0.85 : 0.0
bear_approach_score += bear_proximity ? 0.5 : 0.0
bear_approach_score += native_eff >= eff_min ? 0.50 : -0.25
bear_approach_score += bear_zone_quality > 0.70 ? 1.0 : bear_zone_quality > 0.50 ? 0.5 : bear_zone_quality < min_survival_score ? -1.0 : 0.0
bear_approach_score -= bear_grind_penalty ? 1.0 : 0.0
bear_approach_score += trend_clarity >= 0.45 ? 0.35 : -0.50

bull_reaction_score = 0.0
bull_reaction_score += any_bull_touch and close > open ? 1.0 : 0.0
bull_reaction_score += close > ema_fast ? 0.5 : -0.5
bull_reaction_score += bull_disp ? 1.0 : 0.0
bull_reaction_score += volume > vol_ma * vol_mult ? 0.5 : 0.0
bull_reaction_score += bull_sweep_score > 0 ? 0.25 : 0.0
bull_reaction_score += bull_rejection_score
bull_reaction_score += bull_disp_quality >= disp_quality_min ? 0.75 : bull_disp_quality >= 0.85 ? 0.30 : 0.0
bull_reaction_score -= bear_disp ? 1.0 : 0.0
bull_reaction_score -= bull_acceptance_penalty
bull_reaction_score -= not na(near_bull_ref_all) and close < near_bull_ref_all ? 0.50 : 0.0

bear_reaction_score = 0.0
bear_reaction_score += any_bear_touch and close < open ? 1.0 : 0.0
bear_reaction_score += close < ema_fast ? 0.5 : -0.5
bear_reaction_score += bear_disp ? 1.0 : 0.0
bear_reaction_score += volume > vol_ma * vol_mult ? 0.5 : 0.0
bear_reaction_score += bear_sweep_score > 0 ? 0.25 : 0.0
bear_reaction_score += bear_rejection_score
bear_reaction_score += bear_disp_quality >= disp_quality_min ? 0.75 : bear_disp_quality >= 0.85 ? 0.30 : 0.0
bear_reaction_score -= bull_disp ? 1.0 : 0.0
bear_reaction_score -= bear_acceptance_penalty
bear_reaction_score -= not na(near_bear_ref_all) and close > near_bear_ref_all ? 0.50 : 0.0

//=====================================================
// Zone Interaction Path
//=====================================================
bull_reclaim_path = recent_bull_sweep and bull_proximity and bull_rejection_score > 0
bear_reclaim_path = recent_bear_sweep and bear_proximity and bear_rejection_score > 0

bull_retest_path = bull_proximity and close > ema_fast and low <= nz(near_bull_ref_all, low)
bear_retest_path = bear_proximity and close < ema_fast and high >= nz(near_bear_ref_all, high)

bull_impulse_path = not na(ta.barssince(bull_disp)) and ta.barssince(bull_disp) <= 3 and bull_proximity
bear_impulse_path = not na(ta.barssince(bear_disp)) and ta.barssince(bear_disp) <= 3 and bear_proximity

bull_grind_path = bull_proximity and close < close[1] and close[1] < close[2] and native_eff < eff_min
bear_grind_path = bear_proximity and close > close[1] and close[1] > close[2] and native_eff < eff_min

bull_path_score = 0.0
bull_path_score += bull_reclaim_path ? path_reclaim_bonus : 0.0
bull_path_score += bull_retest_path ? path_retest_bonus : 0.0
bull_path_score += bull_impulse_path ? path_impulse_bonus : 0.0
bull_path_score -= bull_grind_path ? path_grind_penalty : 0.0
bull_path_score += bull_liq_density * 0.35
bull_path_score += bull_zone_stability * 0.35

bear_path_score = 0.0
bear_path_score += bear_reclaim_path ? path_reclaim_bonus : 0.0
bear_path_score += bear_retest_path ? path_retest_bonus : 0.0
bear_path_score += bear_impulse_path ? path_impulse_bonus : 0.0
bear_path_score -= bear_grind_path ? path_grind_penalty : 0.0
bear_path_score += bear_liq_density * 0.35
bear_path_score += bear_zone_stability * 0.35

//=====================================================
// R7 Probability Responsibility Engine
//=====================================================
dist_fast_atr = atr_val > 0 ? math.abs(close - ema_fast) / atr_val : 0.0

long_dist_over = f_clamp((dist_fast_atr - first_pullback_atr_act) / math.max(late_dist_atr_act, 0.10), 0.0, 1.5)
short_dist_over = f_clamp((dist_fast_atr - first_pullback_atr_act) / math.max(late_dist_atr_act, 0.10), 0.0, 1.5)

long_jump_over = close > close[1] and jump_proxy > jump_atr_max ? f_clamp((jump_proxy - jump_atr_max) / math.max(jump_atr_max, 0.10), 0.0, 1.5) : 0.0
short_jump_over = close < close[1] and jump_proxy > jump_atr_max ? f_clamp((jump_proxy - jump_atr_max) / math.max(jump_atr_max, 0.10), 0.0, 1.5) : 0.0

long_advsel = f_clamp(
    0.26 * long_dist_over +
    0.16 * (in_premium ? 1.0 : 0.0) +
    0.22 * f_clamp(long_directional_risk / math.max(max_directional_risk, 0.10), 0.0, 1.0) +
    0.16 * (is_eth and resid_bull_exhaust ? 1.0 : 0.0) +
    0.20 * long_jump_over,
    0.0,
    1.5
)

short_advsel = f_clamp(
    0.26 * short_dist_over +
    0.16 * (in_discount ? 1.0 : 0.0) +
    0.22 * f_clamp(short_directional_risk / math.max(max_directional_risk, 0.10), 0.0, 1.0) +
    0.16 * (is_eth and resid_bear_exhaust ? 1.0 : 0.0) +
    0.20 * short_jump_over,
    0.0,
    1.5
)

trend_coherence_long = (
    (native_bias == 1 ? 1.0 : 0.0) +
    (htf1_bias == 1 ? 1.0 : 0.0) +
    (htf2_bias != -1 ? 1.0 : 0.0) +
    (trend_state ? 1.0 : transition_state ? 0.6 : 0.0) +
    (bull_path_score > 0 ? 1.0 : 0.0) +
    (bull_zone_stability > 0.40 ? 1.0 : 0.0)
) / 6.0

trend_coherence_short = (
    (native_bias == -1 ? 1.0 : 0.0) +
    (htf1_bias == -1 ? 1.0 : 0.0) +
    (htf2_bias != 1 ? 1.0 : 0.0) +
    (trend_state ? 1.0 : transition_state ? 0.6 : 0.0) +
    (bear_path_score > 0 ? 1.0 : 0.0) +
    (bear_zone_stability > 0.40 ? 1.0 : 0.0)
) / 6.0

reversal_coherence_long = (
    (recent_bull_sweep ? 1.0 : 0.0) +
    (in_discount ? 1.0 : 0.0) +
    (htf1_bias != -1 ? 1.0 : 0.0) +
    (htf2_bias != -1 ? 1.0 : 0.0) +
    ((bull_rejection_score > 0 or bull_liq_density > 0.45) ? 1.0 : 0.0) +
    (bull_zone_stability > 0.35 ? 1.0 : 0.0)
) / 6.0

reversal_coherence_short = (
    (recent_bear_sweep ? 1.0 : 0.0) +
    (in_premium ? 1.0 : 0.0) +
    (htf1_bias != 1 ? 1.0 : 0.0) +
    (htf2_bias != 1 ? 1.0 : 0.0) +
    ((bear_rejection_score > 0 or bear_liq_density > 0.45) ? 1.0 : 0.0) +
    (bear_zone_stability > 0.35 ? 1.0 : 0.0)
) / 6.0

norm_long_reg = f_clamp((long_regime_score + 1.5) / 4.0, 0.0, 1.0)
norm_short_reg = f_clamp((short_regime_score + 1.5) / 4.0, 0.0, 1.0)
norm_bull_disp = f_clamp(bull_disp_quality / 2.0, 0.0, 1.0)
norm_bear_disp = f_clamp(bear_disp_quality / 2.0, 0.0, 1.0)
norm_bull_path = f_clamp((bull_path_score + 1.0) / 3.0, 0.0, 1.0)
norm_bear_path = f_clamp((bear_path_score + 1.0) / 3.0, 0.0, 1.0)
norm_bull_react = f_clamp(bull_reaction_score / 4.0, 0.0, 1.0)
norm_bear_react = f_clamp(bear_reaction_score / 4.0, 0.0, 1.0)
norm_bull_reject = f_clamp(bull_rejection_score / 2.0, 0.0, 1.0)
norm_bear_reject = f_clamp(bear_rejection_score / 2.0, 0.0, 1.0)

// R7 responsibility split: structural state owns the prior. Reaction,
// displacement, coherence, and acceptance belong to the later evidence update.
// Directional risk and adverse selection are excluded from both and evaluated
// only by target dispersion and EV.
long_rev_prior_core = 0.33 * bull_zone_stability + 0.22 * bull_liq_density + 0.15 * norm_long_reg + 0.12 * (in_discount ? 1.0 : 0.0) + 0.09 * (htf1_bias != -1 ? 1.0 : 0.0) + 0.09 * (htf2_bias != -1 ? 1.0 : 0.0)
short_rev_prior_core = 0.33 * bear_zone_stability + 0.22 * bear_liq_density + 0.15 * norm_short_reg + 0.12 * (in_premium ? 1.0 : 0.0) + 0.09 * (htf1_bias != 1 ? 1.0 : 0.0) + 0.09 * (htf2_bias != 1 ? 1.0 : 0.0)

long_cont_prior_core = 0.45 * bull_zone_stability + 0.27 * bull_liq_density + 0.18 * norm_long_reg + 0.10 * (native_bias == 1 and htf1_bias == 1 ? 1.0 : 0.0)
short_cont_prior_core = 0.45 * bear_zone_stability + 0.27 * bear_liq_density + 0.18 * norm_short_reg + 0.10 * (native_bias == -1 and htf1_bias == -1 ? 1.0 : 0.0)

prior_long_rev = f_sigmoid(prior_sigmoid_slope * (long_rev_prior_core - 0.50))
prior_short_rev = f_sigmoid(prior_sigmoid_slope * (short_rev_prior_core - 0.50))
prior_long_cont = f_sigmoid(prior_sigmoid_slope * (long_cont_prior_core - 0.50))
prior_short_cont = f_sigmoid(prior_sigmoid_slope * (short_cont_prior_core - 0.50))

long_rev_evidence = 0.0
long_rev_evidence += evidence_follow_weight * ((bull_reclaim_path ? 0.45 : 0.0) + (bull_retest_path ? 0.25 : 0.0) + (bull_reaction_score > 1.0 ? 0.30 : 0.0))
long_rev_evidence += evidence_coherence_weight * reversal_coherence_long
long_rev_evidence -= evidence_accept_weight * f_clamp(bull_acceptance_penalty + bull_zone_hazard, 0.0, 1.5)

short_rev_evidence = 0.0
short_rev_evidence += evidence_follow_weight * ((bear_reclaim_path ? 0.45 : 0.0) + (bear_retest_path ? 0.25 : 0.0) + (bear_reaction_score > 1.0 ? 0.30 : 0.0))
short_rev_evidence += evidence_coherence_weight * reversal_coherence_short
short_rev_evidence -= evidence_accept_weight * f_clamp(bear_acceptance_penalty + bear_zone_hazard, 0.0, 1.5)

long_cont_evidence = 0.0
long_cont_evidence += evidence_follow_weight * ((bull_impulse_path ? 0.40 : 0.0) + (bull_disp_quality >= disp_quality_min ? 0.35 : 0.0) + (bull_reaction_score > 1.0 ? 0.25 : 0.0))
long_cont_evidence += evidence_coherence_weight * trend_coherence_long
long_cont_evidence -= evidence_accept_weight * f_clamp(bull_zone_hazard + bull_acceptance_penalty, 0.0, 1.5)
long_cont_evidence -= chop_state ? 0.25 : 0.0
long_cont_evidence -= panic_state ? 0.35 : 0.0

short_cont_evidence = 0.0
short_cont_evidence += evidence_follow_weight * ((bear_impulse_path ? 0.40 : 0.0) + (bear_disp_quality >= disp_quality_min ? 0.35 : 0.0) + (bear_reaction_score > 1.0 ? 0.25 : 0.0))
short_cont_evidence += evidence_coherence_weight * trend_coherence_short
short_cont_evidence -= evidence_accept_weight * f_clamp(bear_zone_hazard + bear_acceptance_penalty, 0.0, 1.5)
short_cont_evidence -= chop_state ? 0.25 : 0.0
short_cont_evidence -= panic_state ? 0.35 : 0.0

posterior_long_rev = f_sigmoid(f_logit(prior_long_rev) + posterior_sigmoid_slope * (long_rev_evidence - 0.20))
posterior_short_rev = f_sigmoid(f_logit(prior_short_rev) + posterior_sigmoid_slope * (short_rev_evidence - 0.20))
posterior_long_cont = f_sigmoid(f_logit(prior_long_cont) + posterior_sigmoid_slope * (long_cont_evidence - 0.20))
posterior_short_cont = f_sigmoid(f_logit(prior_short_cont) + posterior_sigmoid_slope * (short_cont_evidence - 0.20))

//=====================================================
// Archetype Engine
//=====================================================
bull_impulse_event = bull_major_sweep or bos_bull or bull_disp
bear_impulse_event = bear_major_sweep or bos_bear or bear_disp

bars_since_bull_impulse = ta.barssince(bull_impulse_event)
bars_since_bear_impulse = ta.barssince(bear_impulse_event)

//dist_fast_atr = atr_val > 0 ? math.abs(close - ema_fast) / atr_val : 0.0

long_late_penalty = 0.0
long_late_penalty += dist_fast_atr > late_dist_atr_act ? 1.0 : 0.0
long_late_penalty += in_premium ? 0.75 : 0.0
long_late_penalty += not na(bars_since_bull_impulse) and bars_since_bull_impulse > continuation_window_act ? 1.0 : 0.0
long_late_penalty += bull_leg_long_count > 0 ? 1.25 : 0.0

short_late_penalty = 0.0
short_late_penalty += dist_fast_atr > late_dist_atr_act ? 1.0 : 0.0
short_late_penalty += in_discount ? 0.75 : 0.0
short_late_penalty += not na(bars_since_bear_impulse) and bars_since_bear_impulse > continuation_window_act ? 1.0 : 0.0
short_late_penalty += bear_leg_short_count > 0 ? 1.25 : 0.0

legacy_continuation_long_quality = (
    native_bias == 1 and
    htf1_bias == 1 and
    htf2_bias != -1 and
    bull_zone_quality >= zone_hard_gate_act and
    bull_zone_stability >= 0.30 and
    bull_proximity and
    not chop_state and
    not panic_state and
    not continuation_chop_block and
    long_directional_risk <= max_directional_risk and
    not na(bars_since_bull_impulse) and
    bars_since_bull_impulse <= continuation_window_act and
    dist_fast_atr <= first_pullback_atr_act and
    bull_reaction_score >= continuation_react_min_act and
    bull_disp_quality >= disp_quality_min and
    bull_path_score >= 0.35 and
    bull_leg_long_count < max_longs_per_bull_leg_act and
    long_late_penalty <= 1.0
)

legacy_continuation_short_quality = (
    native_bias == -1 and
    htf1_bias == -1 and
    htf2_bias != 1 and
    bear_zone_quality >= zone_hard_gate_act and
    bear_zone_stability >= 0.30 and
    bear_proximity and
    not chop_state and
    not panic_state and
    not continuation_chop_block and
    short_directional_risk <= max_directional_risk and
    not na(bars_since_bear_impulse) and
    bars_since_bear_impulse <= continuation_window_act and
    dist_fast_atr <= first_pullback_atr_act and
    bear_reaction_score >= continuation_react_min_act and
    bear_disp_quality >= disp_quality_min and
    bear_path_score >= 0.35 and
    bear_leg_short_count < max_shorts_per_bear_leg_act and
    short_late_penalty <= 1.0
)

// R7 context gates keep setup identity, bias, zone, and location responsibilities.
// Directional risk and adverse selection are priced later by target/EV.
// BOS/displacement/FVG/reaction ordering is owned by the causal sequence,
// while their quality remains evaluated by the routed posterior and diagnostic score.
long_continuation_context_ready = (
    native_bias == 1 and
    htf1_bias == 1 and
    htf2_bias != -1 and
    bull_zone_quality >= zone_hard_gate_act and
    bull_zone_stability >= 0.30 and
    bull_proximity and
    not chop_state and
    not panic_state and
    not continuation_chop_block and
    dist_fast_atr <= first_pullback_atr_act and
    bull_leg_long_count < max_longs_per_bull_leg_act and
    long_late_penalty <= 1.0
)

short_continuation_context_ready = (
    native_bias == -1 and
    htf1_bias == -1 and
    htf2_bias != 1 and
    bear_zone_quality >= zone_hard_gate_act and
    bear_zone_stability >= 0.30 and
    bear_proximity and
    not chop_state and
    not panic_state and
    not continuation_chop_block and
    dist_fast_atr <= first_pullback_atr_act and
    bear_leg_short_count < max_shorts_per_bear_leg_act and
    short_late_penalty <= 1.0
)

long_reversal_liquidity_qualified = bull_rev_major_source or (not na(bull_rev_sweep_density) and bull_rev_sweep_density >= liq_minor_reversal_min)
short_reversal_liquidity_qualified = bear_rev_major_source or (not na(bear_rev_sweep_density) and bear_rev_sweep_density >= liq_minor_reversal_min)
long_reversal_reaction_quality = (bull_rejection_score + bull_liq_density * 0.75) >= reversal_reject_min_act
short_reversal_reaction_quality = (bear_rejection_score + bear_liq_density * 0.75) >= reversal_reject_min_act

long_reversal_context_ready = (
    long_reversal_liquidity_qualified and
    bull_zone_quality >= zone_hard_gate_act and
    bull_zone_stability >= 0.35 and
    bull_acceptance_penalty <= 0.25 and
    in_discount
)

short_reversal_context_ready = (
    short_reversal_liquidity_qualified and
    bear_zone_quality >= zone_hard_gate_act and
    bear_zone_stability >= 0.35 and
    bear_acceptance_penalty <= 0.25 and
    in_premium
)

long_reversal_score = 0.0
long_reversal_score += bull_zone_quality * 2.0
long_reversal_score += bull_zone_stability * 1.4
long_reversal_score += bull_rejection_score * 1.5
long_reversal_score += bull_liq_density * 1.0
long_reversal_score += bull_path_score * 1.2
long_reversal_score += recent_bull_major_sweep ? 1.8 : recent_bull_minor_sweep ? 0.65 : 0.0
long_reversal_score += in_discount ? 1.0 : 0.0
long_reversal_score += long_regime_score
long_reversal_score += long_reversal_state_adj
long_reversal_score += posterior_long_rev * 1.35
long_reversal_score += reversal_coherence_long * 0.85
long_reversal_score += is_eth and resid_bull_state ? 0.45 : 0.0
long_reversal_score -= is_eth and resid_bull_exhaust ? 0.60 : 0.0
long_reversal_score += is_eth ? (eth_filter_long ? 0.75 : -2.0) : 0.0
long_reversal_score -= bull_acceptance_penalty
long_reversal_score -= bull_zone_hazard * 1.1
long_reversal_score -= long_late_penalty * 0.4
long_reversal_score -= long_directional_risk * 0.8
long_reversal_score -= long_advsel * 0.95

short_reversal_score = 0.0
short_reversal_score += bear_zone_quality * 2.0
short_reversal_score += bear_zone_stability * 1.4
short_reversal_score += bear_rejection_score * 1.5
short_reversal_score += bear_liq_density * 1.0
short_reversal_score += bear_path_score * 1.2
short_reversal_score += recent_bear_major_sweep ? 1.8 : recent_bear_minor_sweep ? 0.65 : 0.0
short_reversal_score += in_premium ? 1.0 : 0.0
short_reversal_score += short_regime_score
short_reversal_score += short_reversal_state_adj
short_reversal_score += posterior_short_rev * 1.35
short_reversal_score += reversal_coherence_short * 0.85
short_reversal_score += is_eth and resid_bear_state ? 0.45 : 0.0
short_reversal_score -= is_eth and resid_bear_exhaust ? 0.60 : 0.0
short_reversal_score += is_eth ? (eth_filter_short ? 0.75 : -2.0) : 0.0
short_reversal_score -= bear_acceptance_penalty
short_reversal_score -= bear_zone_hazard * 1.1
short_reversal_score -= short_late_penalty * 0.4
short_reversal_score -= short_directional_risk * 0.8
short_reversal_score -= short_advsel * 0.95

long_continuation_score = 0.0
long_continuation_score += bull_zone_quality * 1.8
long_continuation_score += bull_zone_stability * 1.2
long_continuation_score += bull_approach_score
long_continuation_score += bull_reaction_score
long_continuation_score += bull_path_score * 0.9
long_continuation_score += long_regime_score
long_continuation_score += long_cont_state_adj
long_continuation_score += legacy_continuation_long_quality ? 1.5 : 0.0
long_continuation_score += posterior_long_cont * 1.35
long_continuation_score += trend_coherence_long * 0.85
long_continuation_score += is_eth and resid_bull_state ? 0.55 : 0.0
long_continuation_score -= is_eth and resid_bull_exhaust ? 0.75 : 0.0
long_continuation_score += is_eth ? (eth_filter_long ? 0.75 : -2.0) : 0.0
long_continuation_score -= bull_zone_hazard * 0.9
long_continuation_score -= long_late_penalty
long_continuation_score -= long_directional_risk * 1.0
long_continuation_score -= long_advsel * 1.05

short_continuation_score = 0.0
short_continuation_score += bear_zone_quality * 1.8
short_continuation_score += bear_zone_stability * 1.2
short_continuation_score += bear_approach_score
short_continuation_score += bear_reaction_score
short_continuation_score += bear_path_score * 0.9
short_continuation_score += short_regime_score
short_continuation_score += short_cont_state_adj
short_continuation_score += legacy_continuation_short_quality ? 1.5 : 0.0
short_continuation_score += posterior_short_cont * 1.35
short_continuation_score += trend_coherence_short * 0.85
short_continuation_score += is_eth and resid_bear_state ? 0.55 : 0.0
short_continuation_score -= is_eth and resid_bear_exhaust ? 0.75 : 0.0
short_continuation_score += is_eth ? (eth_filter_short ? 0.75 : -2.0) : 0.0
short_continuation_score -= bear_zone_hazard * 0.9
short_continuation_score -= short_late_penalty
short_continuation_score -= short_directional_risk * 1.0
short_continuation_score -= short_advsel * 1.05

//=====================================================
// R5.1 Bull / Bear / Range Expert Models
// Archetype codes: 1=TC, 2=CT, 3=REV, 4=RNG.
// The persistent D/W regime owns routing; the raw regime is used only to
// identify deterioration or a breakout transition before persistence flips.
//=====================================================
// Candidate state is declared before probability/EV evaluation so a pending
// setup can select its snapshotted archetype without recreating setup gates.
var int candidate_setup_counter = 0
var int candidate_pending_setup_id = na
var int candidate_pending_direction = 0
var int candidate_pending_bar = na
var int candidate_snapshot_expert = 2
var int candidate_snapshot_archetype = 0
var float candidate_snapshot_confirmation = na
var float candidate_snapshot_invalidation = na
var float candidate_snapshot_posterior = na
var float candidate_snapshot_coherence = na
var float candidate_snapshot_advsel = na
var float candidate_snapshot_score = na
var float candidate_snapshot_rr = na
var float candidate_snapshot_ev = na
var bool candidate_posterior_latched = false

r5_expert_available = market_regime_initialized and market_regime_available
r5_expert_state = r5_expert_available ? market_regime_state : 2
r5_bull_expert = r5_expert_available and market_regime_state == 1
r5_range_expert = r5_expert_available and market_regime_state == 0
r5_bear_expert = r5_expert_available and market_regime_state == -1

bull_reversal_deterioration = market_regime_transition or raw_market_regime_state != 1
bear_reversal_deterioration = market_regime_transition or raw_market_regime_state != -1
range_breakout_bull_context = raw_market_regime_state == 1 or (market_regime_transition and market_p_bull > market_p_bear)
range_breakout_bear_context = raw_market_regime_state == -1 or (market_regime_transition and market_p_bear > market_p_bull)

bull_ct_short_sequence_ready = bear_reversal_sequence_stage == 5 or (bear_reversal_sequence_stage == 4 and short_reversal_reaction_quality)
bear_ct_long_sequence_ready = bull_reversal_sequence_stage == 5 or (bull_reversal_sequence_stage == 4 and long_reversal_reaction_quality)

bull_tc_long_ready = r5_bull_expert and long_continuation_context_ready and bull_continuation_sequence_stage == 4
bull_rev_short_ready = r5_bull_expert and short_reversal_context_ready and bear_reversal_sequence_stage == 5 and bear_rev_major_source and bull_reversal_deterioration
bull_ct_short_ready = r5_bull_expert and short_reversal_context_ready and bull_ct_short_sequence_ready and not bull_rev_short_ready

bear_tc_short_ready = r5_bear_expert and short_continuation_context_ready and bear_continuation_sequence_stage == 4
bear_rev_long_ready = r5_bear_expert and long_reversal_context_ready and bull_reversal_sequence_stage == 5 and bull_rev_major_source and bear_reversal_deterioration
bear_ct_long_ready = r5_bear_expert and long_reversal_context_ready and bear_ct_long_sequence_ready and not bear_rev_long_ready

range_breakout_long_ready = r5_range_expert and range_breakout_bull_context and long_continuation_context_ready and bull_continuation_sequence_stage == 4
range_breakout_short_ready = r5_range_expert and range_breakout_bear_context and short_continuation_context_ready and bear_continuation_sequence_stage == 4
range_rng_long_ready = r5_range_expert and long_reversal_context_ready and bull_range_sequence_stage == 4
range_rng_short_ready = r5_range_expert and short_reversal_context_ready and bear_range_sequence_stage == 4

r5_long_archetype_code = r5_bull_expert ? (bull_tc_long_ready ? 1 : 0) : r5_bear_expert ? (bear_rev_long_ready ? 3 : bear_ct_long_ready ? 2 : 0) : r5_range_expert ? (range_breakout_long_ready ? 1 : range_rng_long_ready ? 4 : 0) : 0
r5_short_archetype_code = r5_bear_expert ? (bear_tc_short_ready ? 1 : 0) : r5_bull_expert ? (bull_rev_short_ready ? 3 : bull_ct_short_ready ? 2 : 0) : r5_range_expert ? (range_breakout_short_ready ? 1 : range_rng_short_ready ? 4 : 0) : 0

r5_long_uses_reversal = r5_long_archetype_code == 2 or r5_long_archetype_code == 3 or r5_long_archetype_code == 4
r5_short_uses_reversal = r5_short_archetype_code == 2 or r5_short_archetype_code == 3 or r5_short_archetype_code == 4
r5_long_uses_continuation = r5_long_archetype_code == 1
r5_short_uses_continuation = r5_short_archetype_code == 1

r5_long_active_score = r5_long_uses_reversal ? long_reversal_score : r5_long_uses_continuation ? long_continuation_score : na
r5_short_active_score = r5_short_uses_reversal ? short_reversal_score : r5_short_uses_continuation ? short_continuation_score : na

// During Pending, probability/EV/risk are evaluated by the snapshotted
// archetype. Current setup readiness is intentionally not recreated.
evaluation_long_archetype_code = candidate_pending_direction == 1 ? candidate_snapshot_archetype : r5_long_archetype_code
evaluation_short_archetype_code = candidate_pending_direction == -1 ? candidate_snapshot_archetype : r5_short_archetype_code
evaluation_long_uses_reversal = evaluation_long_archetype_code == 2 or evaluation_long_archetype_code == 3 or evaluation_long_archetype_code == 4
evaluation_short_uses_reversal = evaluation_short_archetype_code == 2 or evaluation_short_archetype_code == 3 or evaluation_short_archetype_code == 4
evaluation_long_uses_continuation = evaluation_long_archetype_code == 1
evaluation_short_uses_continuation = evaluation_short_archetype_code == 1

selected_long_posterior = evaluation_long_uses_reversal ? posterior_long_rev : evaluation_long_uses_continuation ? posterior_long_cont : math.max(posterior_long_rev, posterior_long_cont)
selected_short_posterior = evaluation_short_uses_reversal ? posterior_short_rev : evaluation_short_uses_continuation ? posterior_short_cont : math.max(posterior_short_rev, posterior_short_cont)

selected_long_coherence = evaluation_long_uses_reversal ? reversal_coherence_long : evaluation_long_uses_continuation ? trend_coherence_long : math.max(reversal_coherence_long, trend_coherence_long)
selected_short_coherence = evaluation_short_uses_reversal ? reversal_coherence_short : evaluation_short_uses_continuation ? trend_coherence_short : math.max(reversal_coherence_short, trend_coherence_short)

selected_long_advsel = evaluation_long_uses_reversal ? long_advsel * 0.90 : long_advsel
selected_short_advsel = evaluation_short_uses_reversal ? short_advsel * 0.90 : short_advsel

tf_sec = timeframe.in_seconds()
session_seconds = is_crypto_profile ? 86400.0 : 23400.0
bars_per_day = timeframe.isintraday ? math.max(0.01, session_seconds / tf_sec) : timeframe.isdaily ? 1.0 : timeframe.isweekly ? (is_crypto_profile ? 1.0 / 7.0 : 1.0 / 5.0) : timeframe.ismonthly ? (is_crypto_profile ? 1.0 / 30.0 : 1.0 / 21.0) : math.max(0.01, 86400.0 / tf_sec)

base_mu_d = ta.ema(log_ret, 10) * bars_per_day
base_sigma_d = math.max(rv * math.sqrt(bars_per_day), 0.0001)

norm_long_reg2 = f_clamp((long_regime_score + 1.5) / 4.0, 0.0, 1.0)
norm_short_reg2 = f_clamp((short_regime_score + 1.5) / 4.0, 0.0, 1.0)

mu_long_d = base_mu_d + drift_feature_weight * (selected_long_posterior - 0.5) + drift_regime_weight * (norm_long_reg2 - 0.5) + (is_eth and resid_bull_state ? 0.004 : 0.0) - drift_advsel_weight * selected_long_advsel - drift_risk_weight * long_directional_risk

mu_short_d = base_mu_d - drift_feature_weight * (selected_short_posterior - 0.5) - drift_regime_weight * (norm_short_reg2 - 0.5) - (is_eth and resid_bear_state ? 0.004 : 0.0) + drift_advsel_weight * selected_short_advsel + drift_risk_weight * short_directional_risk

sigma_long_d = base_sigma_d * (1.0 + vol_risk_mult * long_directional_risk + vol_advsel_mult * selected_long_advsel + vol_panic_mult * (panic_state ? 1.0 : 0.0))
sigma_short_d = base_sigma_d * (1.0 + vol_risk_mult * short_directional_risk + vol_advsel_mult * selected_short_advsel + vol_panic_mult * (panic_state ? 1.0 : 0.0))

target_horizon_sigma = base_sigma_d * math.sqrt(target_horizon_days)
normalized_barrier_min = f_clamp(us_target_sigma_min * target_horizon_sigma, math.log(1.01), math.log(1.30))
normalized_barrier_max = f_clamp(math.max(us_target_sigma_max, us_target_sigma_min) * target_horizon_sigma, normalized_barrier_min, math.log(1.40))

// Crypto keeps the explicit seven-day 6-7% first-passage objective. US/other
// profiles use their own realized horizon volatility, so leveraged ETFs such as
// QLD are not judged by the same raw percentage barrier as BTC or ETH.
up_a_min = is_crypto_profile ? math.log(1.0 + target_move_min_pct) : normalized_barrier_min
up_a_max = is_crypto_profile ? math.log(1.0 + target_move_max_pct) : normalized_barrier_max
dn_a_min = is_crypto_profile ? math.abs(math.log(1.0 - target_move_min_pct)) : normalized_barrier_min
dn_a_max = is_crypto_profile ? math.abs(math.log(1.0 - target_move_max_pct)) : normalized_barrier_max

p_long_up_min = f_hit_up_prob(mu_long_d, sigma_long_d, target_horizon_days, up_a_min)
p_long_up_max = f_hit_up_prob(mu_long_d, sigma_long_d, target_horizon_days, up_a_max)
p_long_dn_min = f_hit_down_prob(mu_long_d, sigma_long_d, target_horizon_days, dn_a_min)
p_long_dn_max = f_hit_down_prob(mu_long_d, sigma_long_d, target_horizon_days, dn_a_max)

p_short_dn_min = f_hit_down_prob(mu_short_d, sigma_short_d, target_horizon_days, dn_a_min)
p_short_dn_max = f_hit_down_prob(mu_short_d, sigma_short_d, target_horizon_days, dn_a_max)
p_short_up_min = f_hit_up_prob(mu_short_d, sigma_short_d, target_horizon_days, up_a_min)
p_short_up_max = f_hit_up_prob(mu_short_d, sigma_short_d, target_horizon_days, up_a_max)

target_long_band_prob = 0.60 * p_long_up_min + 0.40 * p_long_up_max
target_short_band_prob = 0.60 * p_short_dn_min + 0.40 * p_short_dn_max

adverse_long_band_prob = 0.60 * p_long_dn_min + 0.40 * p_long_dn_max
adverse_short_band_prob = 0.60 * p_short_up_min + 0.40 * p_short_up_max

target_long_ok = target_long_band_prob >= target_prob_min and adverse_long_band_prob <= adverse_prob_max
target_short_ok = target_short_band_prob >= target_prob_min and adverse_short_band_prob <= adverse_prob_max

bull_sweep_prob_core = 0.26 * bull_liq_density + 0.22 * bull_zone_stability + 0.18 * norm_bull_reject + 0.14 * reversal_coherence_long + 0.10 * f_clamp((bull_path_score + 1.0) / 3.0, 0.0, 1.0) + 0.10 * (recent_bull_major_sweep ? 1.0 : recent_bull_minor_sweep ? 0.60 : 0.0) - 0.18 * f_clamp(long_directional_risk / math.max(max_directional_risk, 0.10), 0.0, 1.0) - 0.18 * f_clamp(long_advsel, 0.0, 1.0)
bear_sweep_prob_core = 0.26 * bear_liq_density + 0.22 * bear_zone_stability + 0.18 * norm_bear_reject + 0.14 * reversal_coherence_short + 0.10 * f_clamp((bear_path_score + 1.0) / 3.0, 0.0, 1.0) + 0.10 * (recent_bear_major_sweep ? 1.0 : recent_bear_minor_sweep ? 0.60 : 0.0) - 0.18 * f_clamp(short_directional_risk / math.max(max_directional_risk, 0.10), 0.0, 1.0) - 0.18 * f_clamp(short_advsel, 0.0, 1.0)

bull_sweep_prob = f_sigmoid(4.5 * (bull_sweep_prob_core - 0.50))
bear_sweep_prob = f_sigmoid(4.5 * (bear_sweep_prob_core - 0.50))

bull_major_sweep_viz = bull_major_sweep and (not show_filtered_sweeps or bull_sweep_prob >= sweep_prob_min)
bear_major_sweep_viz = bear_major_sweep and (not show_filtered_sweeps or bear_sweep_prob >= sweep_prob_min)

bull_minor_sweep_viz = bull_minor_sweep and not bull_major_sweep and (not show_filtered_sweeps or bull_sweep_prob >= sweep_prob_min)
bear_minor_sweep_viz = bear_minor_sweep and not bear_major_sweep and (not show_filtered_sweeps or bear_sweep_prob >= sweep_prob_min)



long_candidate_rev = r5_long_uses_reversal and posterior_long_rev >= candidate_post_min
short_candidate_rev = r5_short_uses_reversal and posterior_short_rev >= candidate_post_min

long_candidate_cont = r5_long_uses_continuation and posterior_long_cont >= candidate_post_min
short_candidate_cont = r5_short_uses_continuation and posterior_short_cont >= candidate_post_min

long_candidate_raw = long_candidate_rev or long_candidate_cont
short_candidate_raw = short_candidate_rev or short_candidate_cont

//=====================================================
// Risk / RR Proxy
//=====================================================
long_sl = math.min(low, nz(last_swing_low, low)) - atr_val * 0.25
short_sl = math.max(high, nz(last_swing_high, high)) + atr_val * 0.25

long_risk = close - long_sl
short_risk = short_sl - close

long_target_proxy = not na(near_bear_ref_all) and near_bear_ref_all > close ? near_bear_ref_all : close + long_risk * 2.2
short_target_proxy = not na(near_bull_ref_all) and near_bull_ref_all < close ? near_bull_ref_all : close - short_risk * 2.2

rr_long = long_risk > syminfo.mintick ? (long_target_proxy - close) / long_risk : na
rr_short = short_risk > syminfo.mintick ? (close - short_target_proxy) / short_risk : na

rr_long_ok_act = not na(rr_long) and rr_long >= min_rr_act
rr_short_ok_act = not na(rr_short) and rr_short >= min_rr_act

// Posterior already contains coherence evidence. Blending coherence here again
// would count the same information twice in EV.
long_pwin_final = f_clamp(selected_long_posterior, 0.01, 0.99)
short_pwin_final = f_clamp(selected_short_posterior, 0.01, 0.99)

long_reward_proxy = not na(rr_long) ? math.max(rr_long, 0.0) : na
short_reward_proxy = not na(rr_short) ? math.max(rr_short, 0.0) : na

long_risk_proxy = 1.0 + bull_zone_hazard * 1.1 + compression_score * 0.7 + long_late_penalty * 0.35 + long_directional_risk * 0.8 + selected_long_advsel * 0.9 + (panic_state ? 0.35 : 0.0)
short_risk_proxy = 1.0 + bear_zone_hazard * 1.1 + compression_score * 0.7 + short_late_penalty * 0.35 + short_directional_risk * 0.8 + selected_short_advsel * 0.9 + (panic_state ? 0.35 : 0.0)

ev_long = not na(long_reward_proxy) ? long_pwin_final * long_reward_proxy - (1.0 - long_pwin_final) * long_risk_proxy : na
ev_short = not na(short_reward_proxy) ? short_pwin_final * short_reward_proxy - (1.0 - short_pwin_final) * short_risk_proxy : na

ev_long_ok = not na(ev_long) and ev_long >= ev_min_act
ev_short_ok = not na(ev_short) and ev_short >= ev_min_act

//=====================================================
// R7 Final Responsibility Split
// Posterior owns directional confidence. RR, target first-passage probability,
// EV, cooldown, and arming own execution feasibility. Legacy composite scores
// remain diagnostics and no longer independently veto an otherwise valid setup.
//=====================================================
long_posterior_ready = evaluation_long_archetype_code != 0 and selected_long_posterior >= posterior_min
short_posterior_ready = evaluation_short_archetype_code != 0 and selected_short_posterior >= posterior_min

//=====================================================
// R4 Candidate State Machine + R7 Posterior Latch
// Expert setup edge -> one-shot C -> frozen snapshot -> pending
// -> posterior latch and next-bar-or-later price confirmation
// -> independent RR / EV / target / execution checks
// -> L/S, invalidation, or expiry.
//=====================================================
long_candidate_setup_edge = barstate.isconfirmed and long_candidate_raw and (not long_candidate_raw[1] or r5_long_archetype_code != r5_long_archetype_code[1] or r5_expert_state != r5_expert_state[1])
short_candidate_setup_edge = barstate.isconfirmed and short_candidate_raw and (not short_candidate_raw[1] or r5_short_archetype_code != r5_short_archetype_code[1] or r5_expert_state != r5_expert_state[1])

bool long_signal = false
bool short_signal = false
bool long_candidate = false
bool short_candidate = false
int candidate_terminal_event_code = 0
int candidate_final_gate_mask = 0

if barstate.isconfirmed and candidate_pending_direction != 0
    int _candidate_age = bar_index - candidate_pending_bar
    bool _candidate_invalidated = candidate_pending_direction == 1 ? close <= candidate_snapshot_invalidation : close >= candidate_snapshot_invalidation
    bool _candidate_expired = _candidate_age > candidate_pending_expiry_bars
    bool _candidate_price_confirmed = _candidate_age >= 1 and (candidate_pending_direction == 1 ? close > candidate_snapshot_confirmation : close < candidate_snapshot_confirmation)
    bool _candidate_snapshot_valid = candidate_snapshot_expert != 2 and candidate_snapshot_archetype >= 1 and candidate_snapshot_archetype <= 4
    bool _candidate_posterior_ok = candidate_pending_direction == 1 ? selected_long_posterior >= posterior_min : selected_short_posterior >= posterior_min
    bool _candidate_rr_ok = candidate_pending_direction == 1 ? rr_long_ok_act : rr_short_ok_act
    bool _candidate_ev_ok = candidate_pending_direction == 1 ? ev_long_ok : ev_short_ok
    bool _candidate_target_ok = candidate_pending_direction == 1 ? target_long_ok : target_short_ok
    bool _candidate_execution_ok = candidate_pending_direction == 1 ? long_armed and long_cooldown_ok : short_armed and short_cooldown_ok
    candidate_posterior_latched := candidate_posterior_latched or _candidate_posterior_ok
    // Mask bits: price=1, posterior latch=2, RR=4, EV=8, target=16,
    // execution=32, valid frozen route=64. A fully open gate is 127.
    candidate_final_gate_mask := (_candidate_price_confirmed ? 1 : 0) + (candidate_posterior_latched ? 2 : 0) + (_candidate_rr_ok ? 4 : 0) + (_candidate_ev_ok ? 8 : 0) + (_candidate_target_ok ? 16 : 0) + (_candidate_execution_ok ? 32 : 0) + (_candidate_snapshot_valid ? 64 : 0)
    bool _candidate_final_gate = _candidate_snapshot_valid and candidate_posterior_latched and _candidate_rr_ok and _candidate_ev_ok and _candidate_target_ok and _candidate_execution_ok
    if _candidate_invalidated
        candidate_terminal_event_code := candidate_pending_direction == 1 ? 2 : -2
        candidate_pending_direction := 0
        candidate_pending_bar := na
        candidate_posterior_latched := false
    else if _candidate_expired
        candidate_terminal_event_code := candidate_pending_direction == 1 ? 3 : -3
        candidate_pending_direction := 0
        candidate_pending_bar := na
        candidate_posterior_latched := false
    else if _candidate_price_confirmed and _candidate_final_gate
        long_signal := candidate_pending_direction == 1
        short_signal := candidate_pending_direction == -1
        candidate_terminal_event_code := candidate_pending_direction == 1 ? 1 : -1
        candidate_pending_direction := 0
        candidate_pending_bar := na
        candidate_posterior_latched := false

// A simultaneous opposite setup is ambiguous and is not allowed to claim the slot.
// A setup that appears while another candidate is pending is intentionally not queued.
bool candidate_slot_open = candidate_pending_direction == 0 and candidate_terminal_event_code == 0
bool candidate_setup_unambiguous = long_candidate_setup_edge != short_candidate_setup_edge

if candidate_slot_open and candidate_setup_unambiguous
    candidate_setup_counter += 1
    candidate_pending_setup_id := candidate_setup_counter
    candidate_pending_bar := bar_index
    candidate_snapshot_expert := r5_expert_state
    if long_candidate_setup_edge
        candidate_pending_direction := 1
        candidate_snapshot_archetype := r5_long_archetype_code
        candidate_snapshot_confirmation := high
        candidate_snapshot_invalidation := long_sl
        candidate_snapshot_posterior := selected_long_posterior
        candidate_snapshot_coherence := selected_long_coherence
        candidate_snapshot_advsel := long_advsel
        candidate_snapshot_score := r5_long_active_score
        candidate_snapshot_rr := rr_long
        candidate_snapshot_ev := ev_long
        candidate_posterior_latched := long_posterior_ready
        long_candidate := true
    else
        candidate_pending_direction := -1
