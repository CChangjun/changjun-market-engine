//=====================================================
// Utility Functions
//=====================================================
f_clamp(_x, _lo, _hi) =>
    math.max(_lo, math.min(_hi, _x))

f_sigmoid(_x) =>
    1.0 / (1.0 + math.exp(-_x))

f_logit(_p) =>
    _pp = f_clamp(_p, 0.001, 0.999)
    math.log(_pp / (1.0 - _pp))

f_norm_cdf(_x) =>
    float _k = 1.0 / (1.0 + 0.2316419 * math.abs(_x))
    float _poly = _k * (0.319381530 + _k * (-0.356563782 + _k * (1.781477937 + _k * (-1.821255978 + _k * 1.330274429))))
    float _phi = 0.3989422804014327 * math.exp(-0.5 * _x * _x)
    float _cdf = 1.0 - _phi * _poly
    _x >= 0 ? _cdf : 1.0 - _cdf

f_hit_up_prob(_mu_d, _sigma_d, _t_d, _a) =>
    float _sig2 = math.max(_sigma_d * _sigma_d, 0.0000001)
    float _sig_t = math.max(_sigma_d * math.sqrt(math.max(_t_d, 0.0001)), 0.0001)
    float _x1 = (_mu_d * _t_d - _a) / _sig_t
    float _x2 = (-_mu_d * _t_d - _a) / _sig_t
    float _expo = math.max(-50.0, math.min(50.0, 2.0 * _mu_d * _a / _sig2))
    float _term = math.exp(_expo)
    f_clamp(f_norm_cdf(_x1) + _term * f_norm_cdf(_x2), 0.0, 1.0)

f_hit_down_prob(_mu_d, _sigma_d, _t_d, _a) =>
    float _sig2 = math.max(_sigma_d * _sigma_d, 0.0000001)
    float _sig_t = math.max(_sigma_d * math.sqrt(math.max(_t_d, 0.0001)), 0.0001)
    float _x1 = (-_mu_d * _t_d - _a) / _sig_t
    float _x2 = (_mu_d * _t_d - _a) / _sig_t
    float _expo = math.max(-50.0, math.min(50.0, -2.0 * _mu_d * _a / _sig2))
    float _term = math.exp(_expo)
    f_clamp(f_norm_cdf(_x1) + _term * f_norm_cdf(_x2), 0.0, 1.0)

f_zone_text(_tf_name, _dir, _is_ifvg) =>
