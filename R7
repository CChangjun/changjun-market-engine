        int _ce_touch_count = array.get(_ce_touches, _i)
        int _ce_accept_count = array.get(_ce_accepts, _i)
        float _overlap_rvol = array.get(_overlap_rvols, _i)
        float _rejection = array.get(_rejections, _i)
        float _survival_prev = array.get(_survivals, _i)
        bool _inside_prev = array.get(_was_inside, _i)
        bool _ce_inside_prev = array.get(_was_ce_inside, _i)

        float _height = math.max(_top - _bottom, syminfo.mintick)
