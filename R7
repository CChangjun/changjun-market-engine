    float _bar_range = math.max(high - low, syminfo.mintick)
    float _upper_wick = high - math.max(open, close)
    float _lower_wick = math.min(open, close) - low
    float _wick_ratio = (_upper_wick + _lower_wick) / _bar_range
    float _overlap_raw = math.max(0.0, math.min(high, high[1]) - math.max(low, low[1]))
    float _prev_range = math.max(high[1] - low[1], syminfo.mintick)
    float _overlap_ratio = _overlap_raw / _prev_range
