        // This is object safety only. Economic retirement is handled below.
        if array.size(_boxes) > _max_calculation
            f_remove_ob(_boxes, _ce_lines, _tops, _bottoms, _dirs, _source_bars, _confirm_bars, _wick_extremes, _init_qualities, _source_rvols, _disp_rvols, _departures, _fills, _touches, _ce_touches, _ce_accepts, _overlap_rvols, _rejections, _consumptions, _survivals, _was_inside, _was_ce_inside, 0)

f_update_obs(_boxes, _ce_lines, _tops, _bottoms, _dirs, _source_bars, _confirm_bars, _wick_extremes, _init_qualities, _source_rvols, _disp_rvols, _departures, _fills, _touches, _ce_touches, _ce_accepts, _overlap_rvols, _rejections, _consumptions, _survivals, _was_inside, _was_ce_inside, _right_bar, _tf_name, _display, _display_ce, _show_text, _volume_ma, _atr_now, _consumption_retire, _volume_norm, _touch_norm) =>
